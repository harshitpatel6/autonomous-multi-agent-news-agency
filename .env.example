# LLM Provider: "claude", "groq", or "gemini"
LLM_PROVIDER=gemini

# Anthropic Claude API
ANTHROPIC_API_KEY=

# Groq API (fallback)
GROQ_API_KEY=

# Gemini API
GEMINI_API_KEY=

# SMTP Configuration (for sending emails)
# For Gmail, use: smtp.gmail.com on port 587 with an app-specific password
# See: https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
FROM_EMAIL=

# Who receives the digest
DIGEST_RECIPIENT=

# Testing mode: 1 = save to file, 0 = send email
DIGEST_TEST_MODE=1

# Public site base URL (web/) - email headlines link here for full articles
SITE_BASE_URL=http://localhost:3000
